# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev server logs (root-level next-dev-*.log) and agent stdout
next-dev-*.log
next-dev-*.err.log
whatsapp-agent/agent.log
whatsapp-agent/agent.log.old

# env files — ALL of them are ignored. Hostinger reads from the project's
# env-vars panel, NOT from this file, so committing it leaks secrets for
# zero deploy benefit. Was previously overridden with !.env.production
# (see commit b2d044b) until we realised the production file contains the
# Supabase service-role key + ChatGPT JWT.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
