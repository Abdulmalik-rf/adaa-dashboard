# Production env for the dashboard. Auto-loaded by Next.js when NODE_ENV=production.
#
# What's INTENTIONALLY committed here:
#   - OPENAI_CHATGPT_TOKEN — required server-side for the in-dashboard chat
#     widget and the public chatbot (/api/agent/chat). The token is a
#     ~7-day-lived ChatGPT OAuth JWT — refresh from chatgpt.com when it
#     expires.
#   - NEXT_PUBLIC_* — public by design (anon key has RLS enforcement,
#     URL is the project's public hostname).
#   - SUPABASE_URL — same value as NEXT_PUBLIC_SUPABASE_URL. Not sensitive.
#   - OPENAI_MODEL, REASONING_EFFORT, TIMEZONE — non-sensitive config.
#
# What is NOT here (and must NEVER be committed):
#   - SUPABASE_SERVICE_ROLE_KEY — full DB access, no RLS. Set in Hostinger's
#     panel only.
#   - REVALIDATE_SECRET — protects /api/revalidate against drive-by cache
#     poisoning. Set in Hostinger's panel only.
#
# Local dev: keep your full secrets in .env.production.local (gitignored).
# Next.js loads .env.production.local before this file, so local builds
# still see the service-role key while the deployed build reads only what's
# committed here.

NEXT_PUBLIC_SUPABASE_URL=https://ddiaetxjjsobwkrapxnt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2dRH7Gan37TZHRVnrZzmQw_GpLpmaPC
SUPABASE_URL=https://ddiaetxjjsobwkrapxnt.supabase.co

